# =============================================================================
# Job Search Agent - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM Providers ---
# With LLM_PARALLEL_PROVIDERS=true, Gemini and Groq run at the same time.
# Each keeps its own pace. A failed provider still falls through to the next.
# On 401/expired key or quota, that provider is skipped for the rest of the run.
LLM_PROVIDER_ORDER=gemini,groq,cerebras
LLM_PARALLEL_PROVIDERS=true

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Free Flash-Lite ~500 req/day; gemini-3.8-flash is only ~20 free RPD.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash

# Groq (free/dev): https://console.groq.com/keys
# llama-3.1-8b-instant / llama-3.3-70b-versatile = enterprise (Contact Sales) only
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Cerebras (free trial): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODELS=llama3.1-8b,llama-3.3-70b,gpt-oss-120b

# Space LLM calls for quality + free-tier stability (30–60s recommended)
LLM_MIN_INTERVAL_SECONDS=45
LLM_MAX_RETRIES=3


# --- Job Search APIs (at least one recommended) ---
# Adzuna: https://developer.adzuna.com/ (free tier, India supported)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# SerpAPI for Google Jobs: https://serpapi.com/
SERPAPI_KEY=

# Hunter.io — find company employees / emails (https://hunter.io/api-keys)
HUNTER_API_KEY=
HUNTER_ENABLED=true
# Free plan ≈ 50 Domain Search credits/month
HUNTER_MONTHLY_BUDGET=45
HUNTER_MAX_SEARCHES_PER_RUN=5
HUNTER_MAX_CALLS_PER_COMPANY=1
HUNTER_ONLY_WHEN_NEEDED=true
HUNTER_REQUIRE_KNOWN_DOMAIN=true

# Apify — LinkedIn Jobs (https://console.apify.com/settings/integrations)
# Uses bebity/linkedin-jobs-scraper — no LinkedIn login/cookies required
APIFY_API_TOKEN=
APIFY_LINKEDIN_ENABLED=false
APIFY_LINKEDIN_ACTOR=bebity/linkedin-jobs-scraper
# r86400 = past 24h, r604800 = past week
APIFY_LINKEDIN_PUBLISHED_AT=r86400
APIFY_LINKEDIN_MAX_ROWS=50

# Remotive public API (no key required, but can be disabled)
REMOTIVE_ENABLED=true

# Arbeitnow public API (no key required)
ARBEITNOW_ENABLED=true

# Greenhouse board tokens (comma-separated company slugs, e.g. stripe,airbnb)
GREENHOUSE_BOARDS=
# Defaults loaded from data/discovery/company_boards.json when empty

# Lever company slugs (comma-separated)
LEVER_COMPANIES=

# Ashby org slugs (comma-separated)
ASHBY_ORGS=

# SmartRecruiters company slugs (comma-separated)
SMARTRECRUITERS_COMPANIES=

# Internet-wide DuckDuckGo job search (no API key required)
WEB_SEARCH_ENABLED=true

# --- Application Settings ---
DATABASE_URL=sqlite:///./data/job_agent.db
RESUME_PATH=./data/resume/Abhishek_Android_Development_.pdf
MASTER_RESUME_JSON=./data/resume/master_resume.json

# Daily search schedule (cron format or HH:MM in Asia/Kolkata)
DAILY_SEARCH_TIME=07:00
TIMEZONE=Asia/Kolkata

# Job search parameters
MAX_JOBS_PER_SEARCH=200
TOP_JOBS_COUNT=0
# 0 = no cap — every job with score >= TOP_JOBS_PRIORITY_SCORE goes to Excel
TOP_JOBS_PRIORITY_SCORE=70
JOB_RECENCY_HOURS=24
RESUME_GENERATION_THRESHOLD=75
MIN_MATCH_SCORE=0

# Internet-wide discovery expansion
MAX_PAGES_PER_SOURCE=5
MAX_RESULTS_PER_SOURCE=200
SEARCH_QUERY_VARIANTS_PER_PROFILE=10
MAX_JOB_AGE_DAYS=30
MAX_COMPANY_CAREER_DISCOVERY=50
REQUEST_DELAY_SECONDS=1
SOURCE_DELAY_SECONDS=2
ENABLE_REMOTEOK=true
ENABLE_WWR=true
ENABLE_HIMALAYAS=true
ENABLE_ATS_EXTRA=true
ENABLE_COMPANY_CAREER_DISCOVERY=true

# Career portal (ATS) job ID resolution
ENABLE_CAREER_PORTAL_RESOLUTION=true
CAREER_PORTAL_TIMEOUT_SECONDS=12
CAREER_PORTAL_DELAY_SECONDS=0.5
CAREER_PORTAL_CONCURRENCY=4
# Profile-based search. false skips every resume track.
PROFILE_BASED_SEARCH=true
# Per profile: false skips that track, true (or omit) keeps it.
# The id is the folder name without the number: 1-Android → ANDROID, 2-Backend → BACKEND.
PROFILE_ANDROID=true
PROFILE_BACKEND=true
# Empty = auto-discover folders that are still enabled above
ACTIVE_PROFILES=
JOB_LOCATIONS=Mumbai,Thane,Navi Mumbai,Pune,Bangalore,Hyderabad,Chennai,Delhi NCR,India,Remote,Remote India
CACHE_TTL_HOURS=12
RESUME_PROFILES_DIR=./data/resume/profiles

# --- Notifications (optional) ---
NOTIFICATION_ENABLED=false
NOTIFICATION_CHANNEL=console
# email | telegram | slack | console

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack
SLACK_WEBHOOK_URL=

# --- Application Automation ---
AUTO_APPLY_ENABLED=false
REQUIRE_APPROVAL_BEFORE_APPLY=true

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Brave Browser Discovery (read-only, uses logged-in Switch profile) ---
BRAVE_BROWSER_ENABLED=true
BRAVE_PROFILE_DIRECTORY=Profile 2
BRAVE_USER_DATA_DIR=~/Library/Application Support/BraveSoftware/Brave-Browser
# Optional: connect to running Brave with remote debugging (e.g. http://127.0.0.1:9222)
BRAVE_CDP_URL=
BRAVE_HEADLESS=false
# Pause so YOU can solve CAPTCHA in Brave (0 = skip immediately)
BRAVE_CAPTCHA_WAIT_SECONDS=120
BRAVE_PORTALS=indeed,glassdoor,shine,wellfound,naukri
# 0 = one tab per site, all sites at once. Set 4 to search only 4 sites at a time.
BROWSER_PARALLEL_TABS=0
# Optional login-walled (need Switch profile cookies): instahyre,cutshort,foundit,hirist,iimjobs,timesjobs

# --- Referral Agent (separate from job search; no LinkedIn CDP scraping) ---
# Run: .venv/bin/python3 scripts/run_referral_agent.py
HUNTER_API_KEY=
HUNTER_ENABLED=true

# LinkedIn CDP outreach is removed — do not enable
LINKEDIN_OUTREACH_ENABLED=false
LINKEDIN_OUTREACH_THRESHOLD=75
LINKEDIN_MAX_CONTACTS_PER_JOB=3

# --- LaTeX ---
# Backend locked template requires pdfLaTeX (TinyTeX or BasicTeX/MacTeX).
# Tectonic is only a fallback and will not match Final Resume fonts/layout.
LATEX_COMPILER=pdflatex
COMPILE_PDF=true
# TinyTeX (no sudo): export PATH="$PATH:$HOME/Library/TinyTeX/bin/universal-darwin"
